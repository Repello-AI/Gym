# Gym env.yaml for training behind Miles: copy to the Gym repo root as env.yaml.
# Miles sends each episode's session URL on /run as policy_base_url, so the model server below is never called.
policy_base_url: http://localhost:9/v1
policy_api_key: dummy
policy_model_name: model
model_endpoint_readiness_timeout_seconds: 0
default_host: 0.0.0.0
# An env file with OPENAI_API_KEY and ANTHROPIC_API_KEY, for the defender and the judges.
ipi_attacker_api_key_file: /path/to/keys.env
